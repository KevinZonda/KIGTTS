<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.KGTTS" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_background_day</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimary</item>
        <item name="android:navigationBarColor" tools:targetApi="l">?attr/colorSurface</item>
        <item name="android:popupBackground">@drawable/bg_overlay_popup</item>
    </style>

    <style name="Theme.KGTTS.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_day</item>
        <item name="windowSplashScreenBackground">@color/splash_background_day</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.KGTTS</item>
    </style>

    <style name="Theme.KGTTS.Cropper" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">#038387</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor" tools:targetApi="l">#038387</item>
        <item name="android:navigationBarColor" tools:targetApi="l">#000000</item>
    </style>

    <style name="Theme.KGTTS.LockScreenOverlayHostBase" parent="android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:showWhenLocked">true</item>
        <item name="android:turnScreenOn">false</item>
    </style>

    <style name="Theme.KGTTS.LockScreenOverlayHost" parent="@style/Theme.KGTTS.LockScreenOverlayHostBase" />

    <style name="ThemeOverlay.KGTTS.OverlayPopup" parent="">
        <item name="android:popupBackground">@drawable/bg_overlay_popup</item>
        <item name="android:textAppearanceLargePopupMenu">@style/TextAppearance.KGTTS.OverlayPopup.Light</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/TextAppearance.KGTTS.OverlayPopup.Light</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.KGTTS.OverlayPopup.Light</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.KGTTS.OverlayPopup.Light</item>
    </style>

    <style name="ThemeOverlay.KGTTS.OverlayPopup.Light" parent="">
        <item name="android:popupBackground">@drawable/bg_overlay_popup</item>
        <item name="android:textAppearanceLargePopupMenu">@style/TextAppearance.KGTTS.OverlayPopup.Light</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/TextAppearance.KGTTS.OverlayPopup.Light</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.KGTTS.OverlayPopup.Light</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.KGTTS.OverlayPopup.Light</item>
    </style>

    <style name="ThemeOverlay.KGTTS.OverlayPopup.Dark" parent="">
        <item name="android:popupBackground">@drawable/bg_overlay_popup_dark</item>
        <item name="android:textAppearanceLargePopupMenu">@style/TextAppearance.KGTTS.OverlayPopup.Dark</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/TextAppearance.KGTTS.OverlayPopup.Dark</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.KGTTS.OverlayPopup.Dark</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.KGTTS.OverlayPopup.Dark</item>
    </style>

    <style name="TextAppearance.KGTTS.OverlayPopup.Light" parent="@android:style/TextAppearance.Material.Menu">
        <item name="android:textColor">#111417</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.KGTTS.OverlayPopup.Dark" parent="@android:style/TextAppearance.Material.Menu">
        <item name="android:textColor">#E4E8EB</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
